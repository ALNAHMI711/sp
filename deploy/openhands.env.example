# OpenHands runtime configuration
# Copy to the deployment environment; never commit real secrets.

OPENHANDS_HOST=http://127.0.0.1:8000
OPENHANDS_PUBLIC=false

# Generate with:
# openssl rand -base64 32
LOCAL_BACKEND_API_KEY=

# GitHub credentials must be supplied through the runtime secret manager.
# Do not put PATs, GitHub App private keys, Binance keys, or model keys here.
