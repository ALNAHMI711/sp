# Application
APP_ENV=development
APP_NAME=cloud-control-hub
APP_BASE_URL=https://example.invalid

# Authentication - provide a password hash generated outside the repository
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Database
DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub
REDIS_URL=redis://redis:6379/0

# GitHub integration (prefer GitHub App in production)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# AI Operations (optional)
AI_API_KEY=

# Deployment / networking
PUBLIC_HOSTNAME=example.invalid
SSH_USER=deploy
