# Application
APP_ENV=development
APP_NAME=cloud-control-hub
APP_BASE_URL=https://example.invalid

# Authentication - use a strong password hash and random secret in deployment
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Queue/database
CONTROL_QUEUE_BACKEND=sqlite
CONTROL_QUEUE_DB=.data/control-queue.sqlite3
CONTROL_POSTGRES_DSN=
CONTROL_KILL_SWITCH_FILE=.data/KILL_SWITCH
CONTROL_WORKER_REGISTRY_DB=.data/workers.sqlite3

# GitHub integration
GITHUB_OWNER=ALNAHMI711
# Optional: fine-grained token for private repository inventory only.
# Set repository access to the minimum required; Metadata: read-only.
# Store only in the server's secret/environment settings, never in the browser or Git.
GITHUB_READ_TOKEN=
# Required to verify GitHub webhook signatures. Generate a long random secret.
GITHUB_WEBHOOK_SECRET=

# GitHub App integration (future/production preferred over long-lived PAT)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# AI Operations (optional; never expose to the browser)
AI_API_KEY=

# Deployment / networking
PUBLIC_HOSTNAME=example.invalid
SSH_USER=deploy
